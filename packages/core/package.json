{
  "name": "@inteliside/gateway-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gateway Core — the brain. Speaks A2A (remote) and ACP (local) to agents and exposes a WebSocket API to the frontend.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gateway-core": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/acp.test.ts && tsx test/a2a.test.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-alpha.0",
    "@agentclientprotocol/sdk": "^0.25.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "express": "^5.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
