{
  "name": "fleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fleet — multiplexer and operations center for a fleet of agents (Component 2)",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "core:build": "pnpm --filter @inteliside/gateway-core build",
    "core:dev": "pnpm --filter @inteliside/gateway-core dev",
    "core:typecheck": "pnpm --filter @inteliside/gateway-core typecheck",
    "frontend:dev": "pnpm --filter @inteliside/gateway-frontend dev",
    "frontend:build": "pnpm --filter @inteliside/gateway-frontend build",
    "dev": "pnpm --filter @inteliside/gateway-core --filter @inteliside/gateway-frontend --parallel run dev",
    "desktop:dev": "pnpm --filter @inteliside/gateway-desktop dev"
  }
}
