{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleet",
  "version": "0.1.0",
  "identifier": "com.inteliside.fleet",
  "build": {
    "frontendDist": "../../../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @inteliside/gateway-frontend dev",
    "beforeBuildCommand": "pnpm --filter @inteliside/gateway-frontend build && node scripts/build-sidecar.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fleet",
        "width": 1280,
        "height": 832,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/gateway-core"],
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
